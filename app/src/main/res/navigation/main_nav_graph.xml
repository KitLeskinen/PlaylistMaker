<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main_nav_graph"
    app:startDestination="@id/mediaLibraryFragment">
    <fragment
        android:id="@+id/searchFragment"
        android:name="com.practicum.playlistmaker.search.ui.SearchFragment"
        android:label="SearchFragment" />
    <fragment
        android:id="@+id/mediaLibraryFragment"
        android:name="com.practicum.playlistmaker.medialibrary.ui.MediaLibraryFragment"
        android:label="fragment_medialibrary"
        tools:layout="@layout/fragment_medialibrary" >
        <action
            android:id="@+id/action_mediaLibraryFragment_to_playlistScreenFragment"
            app:destination="@id/playlistScreenFragment" />
    </fragment>
    <fragment
        android:id="@+id/settingsFragment"
        android:name="com.practicum.playlistmaker.settings.ui.SettingsFragment"
        android:label="SettingsFragment" />
    <fragment
        android:id="@+id/fragmentNewPlaylist"
        android:name="com.practicum.playlistmaker.medialibrary.ui.NewPlaylistFragment"
        android:label="fragment_new_playlist"
        tools:layout="@layout/fragment_new_playlist" />
    <activity
        android:id="@+id/audioPlayerActivity"
        android:name="com.practicum.playlistmaker.audio_player.ui.AudioPlayerActivity"
        android:label="AudioPlayerActivity" />
    <fragment
        android:id="@+id/playlistScreenFragment"
        android:name="com.practicum.playlistmaker.medialibrary.ui.PlaylistScreenFragment"
        android:label="fragment_playlist_screen"
        tools:layout="@layout/fragment_playlist_screen" >
        <argument
            android:name="playlist"
            app:argType="com.practicum.playlistmaker.common.data.domain.entity.Playlist" />
    </fragment>


</navigation>