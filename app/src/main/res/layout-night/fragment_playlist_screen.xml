<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#E6E8EB"
    android:orientation="vertical">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#E6E8EB">

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/startGuideline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_begin="24dp" />

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/endGuideline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_end="24dp" />


        <ImageView
            android:id="@+id/coverImage"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@android:color/transparent"
            android:scaleType="centerCrop"
            android:src="@drawable/placeholder"

            app:layout_constraintDimensionRatio="w, 1:1"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/backImageView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            app:layout_constraintTop_toTopOf="parent"
            app:navigationIcon="@drawable/back_icon"
            app:navigationIconTint="@color/black"
            app:title="" />

        <TextView
            android:id="@+id/playlistNameTextView"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:fontFamily="@font/ys_display_medium"
            android:text="Best songs 2021"
            android:textColor="#1A1B22"
            android:textFontWeight="700"
            android:textSize="24sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toStartOf="@id/endGuideline"
            app:layout_constraintStart_toEndOf="@id/startGuideline"
            app:layout_constraintTop_toBottomOf="@id/coverImage" />

        <TextView
            android:id="@+id/playlistDescriptionTextView"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="description"
            android:textColor="#1A1B22"
            android:textSize="18sp"
            app:layout_constraintStart_toEndOf="@id/startGuideline"
            app:layout_constraintTop_toBottomOf="@id/playlistNameTextView" />

        <TextView
            android:id="@+id/playlistDurationAndCountTextView"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text=""
            android:textColor="#1A1B22"
            android:textSize="18sp"
            app:layout_constraintStart_toEndOf="@id/startGuideline"
            app:layout_constraintTop_toBottomOf="@id/playlistDescriptionTextView" />

        <ImageButton
            android:id="@+id/shareImageButton"
            android:layout_width="24sp"
            android:layout_height="24sp"
            android:layout_marginTop="16dp"

            android:background="#421616"
            android:backgroundTint="#00B08686"
            android:src="@drawable/share_playlist_icon"
            app:layout_constraintStart_toEndOf="@id/startGuideline"
            app:layout_constraintTop_toBottomOf="@id/playlistDurationAndCountTextView" />

        <ImageButton
            android:id="@+id/meatballsMenu"
            android:layout_width="24sp"
            android:layout_height="24sp"
            android:layout_marginStart="16dp"
            android:layout_marginTop="16dp"

            android:background="#421616"
            android:backgroundTint="#00B08686"
            android:src="@drawable/kebub_icon"
            app:layout_constraintStart_toEndOf="@id/shareImageButton"
            app:layout_constraintTop_toBottomOf="@id/playlistDurationAndCountTextView"

            />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <LinearLayout
        android:id="@+id/bottomSheet"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bottom_sheet_background"
        android:minHeight="100dp"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        app:behavior_hideable="false"
        app:behavior_peekHeight="150dp"

        app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior">


        <View
            android:id="@+id/swipeLine"
            android:layout_width="50dp"
            android:layout_height="4dp"
            android:layout_gravity="center"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bottom_sheet_handle" />



        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/playlistTracksRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/bottomSheetMeatballs"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bottom_sheet_background"
        android:minHeight="100dp"
        android:orientation="vertical"

        android:paddingHorizontal="16dp"
        app:behavior_hideable="true"
        app:behavior_peekHeight="300dp"

        app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior">


        <View
            android:id="@+id/swipeLine2"
            android:layout_width="50dp"
            android:layout_height="4dp"
            android:layout_gravity="center"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bottom_sheet_handle" />
        />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#1A1B22"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/bottomSheetTrackCover"
                android:layout_width="@dimen/trackCoverSideSize_48dp"
                android:layout_height="@dimen/trackCoverSideSize_48dp"
                android:layout_gravity="center_vertical"
                android:layout_marginVertical="@dimen/trackCoverMargin_8dp"

                android:layout_marginEnd="@dimen/trackCoverMargin_8dp"
                android:src="@drawable/placeholder" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:layout_gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/bottomSheetPlaylistName"
                    style="@style/trackName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Playlist Name" />

                <TextView
                    android:id="@+id/bottomSheetTracksCount"
                    style="@style/artistName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="00 треков" />
            </LinearLayout>
        </LinearLayout>

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/shareTextView"

            style="@style/settingsItem"

            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:text="@string/share" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/editInfoTextView"

            style="@style/settingsItem"

            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:text="@string/edit_info" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/deletePlaylistTextView"

            style="@style/settingsItem"

            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:text="@string/delete_playlist" />


    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>